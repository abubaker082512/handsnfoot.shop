# JazzCash Payment Gateway - Environment Variables

# ============================================
# Frontend Environment Variables (.env)
# ============================================

# JazzCash Configuration
VITE_JAZZCASH_RETURN_URL=https://handsnfoot.shop/payment/callback
VITE_JAZZCASH_IPN_URL=https://your-project-ref.supabase.co/functions/v1/jazzcash-ipn

# For local development, use:
# VITE_JAZZCASH_RETURN_URL=http://localhost:5173/payment/callback

# ============================================
# Supabase Edge Functions Secrets
# ============================================
# Add these secrets using Supabase CLI:
# supabase secrets set JAZZCASH_MERCHANT_ID=your_merchant_id
# supabase secrets set JAZZCASH_PASSWORD=your_password
# supabase secrets set JAZZCASH_INTEGRITY_SALT=your_integrity_salt
# supabase secrets set JAZZCASH_ENVIRONMENT=sandbox

JAZZCASH_MERCHANT_ID=your_merchant_id_here
JAZZCASH_PASSWORD=your_password_here
JAZZCASH_INTEGRITY_SALT=your_integrity_salt_here
JAZZCASH_ENVIRONMENT=sandbox  # Change to 'production' when going live

# JazzCash API Endpoints
JAZZCASH_CARD_PAYMENT_URL=https://onlinepayments.jazzcash.com.pk/payment-orchestrator/CustomerPortal/transactionmanagement/merchantform
JAZZCASH_MWALLET_API_URL=https://onlinepayments.jazzcash.com.pk/payment-orchestrator/api/v2/rest/payments/m-wallet
JAZZCASH_STATUS_INQUIRY_URL=https://onlinepayments.jazzcash.com.pk/payment-orchestrator/api/v2/rest/payments/status/inquiry

# Return URLs (must match what's configured in JazzCash portal)
JAZZCASH_RETURN_URL=https://handsnfoot.shop/payment/callback
JAZZCASH_IPN_URL=https://your-project-ref.supabase.co/functions/v1/jazzcash-ipn
