# IPN Version
JAZZCASH_IPN_VERSION=V1

# Easypaisa Payment Gateway Configuration
# Get these credentials from Easypaisa API Developer Portal
# Register at: https://easypaisa.com.pk/developer

# Merchant credentials
EASYPAISA_STORE_ID=your_store_id_here
EASYPAISA_USERNAME=your_username_here
EASYPAISA_PASSWORD=your_password_here
