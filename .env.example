# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# JazzCash Payment Gateway Configuration
# Get these credentials from JazzCash Merchant Portal
JAZZCASH_MERCHANT_ID=your_merchant_id_here
JAZZCASH_PASSWORD=your_password_here
JAZZCASH_INTEGRITY_SALT=your_integrity_salt_here

# JazzCash Return URL (must be registered in JazzCash portal)
# For local development:
JAZZCASH_RETURN_URL=http://localhost:5173/api/jazzcash-return
# For production (update with your domain):
# JAZZCASH_RETURN_URL=https://your-domain.com/api/jazzcash-return

# JazzCash Payment Gateway URL (usually no need to change)
JAZZCASH_CARD_PAYMENT_URL=https://onlinepayments.jazzcash.com.pk/payment-orchestrator/CustomerPortal/transactionmanagement/merchantform
